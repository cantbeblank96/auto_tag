{
    "work_dir": "{PROJECT_PATH}/work_dir",
    "batch_size": 32,
    "tau_dup": 0.05,
    "tau_cls": 0.25,
    "embedding_subdir": "embedding_index",
    "record_stage1_duplicates": true,
    "duplicate_links_filename": "duplicate_links.sqlite",
    "device": "cuda",
    "vlm_models": [
        {
            "id": "00000000-0000-4000-8000-000000000001",
            "name": "gemini/gemini-2.5-flash",
            "base_url": null,
            "api_key": "your_api_key_here",
            "priority": 1,
            "enabled": true,
            "max_tokens": null
        }
    ],
    "questions": {
        "scene": {
            "description": "description of the overall scene",
            "type": "string"
        },
        "time_of_day": {
            "description": "Determine the shooting time shown in the picture scene",
            "type": "category",
            "choices": ["day", "night", "unknown"]
        },
        "num_of_person": {
            "description": "Number of people in the picture",
            "type": "int",
            "min": 0
        },
        "brightness": {
            "description": "Brightness of the picture (0 to 10 points, the bigger, the brighter)",
            "type": "float",
            "min": 0,
            "max": 10,
            "step": 0.1,
            "examples": {
                "2.5": "examples/brightness_2.5.jpg",
                "7.5": "/abs/path/to/brightness_7.5.jpg"
            }
        }
    },
    "vlm_strategy": "round_robin",
    "vlm_concurrency": 10,
    "vlm_http_timeout": 60,
    "vlm_validation_max_corrections": 2,
    "vlm_example_image_max_side": 512,
    "vlm_image_max_side": 0,
    "annotation_tools": {
        "align_model_paths": [
            "/path/to/kevin_sdk/models/alignment/M_Align_occlusion_106_360_xxx.model",
            "/path/to/kevin_sdk/models/alignment/M_Align_occlusion_106_xxx.model"
        ],
        "face_detect": {
            "enabled": true,
            "model_path": "/path/to/kevin_sdk/models/detection/M_Detect_xxx.model",
            "min_score": 0.5
        },
        "head_pose": {
            "enabled": false,
            "model_path": "/path/to/kevin_sdk/models/head_pose/M_Align_CalcPose_xxx.model"
        },
        "face_attribute": {
            "enabled": false,
            "model_path": "/path/to/kevin_sdk/models/attribute/M_FaceAttribute_xxx.model"
        }
    },
    "vlm_chain_dump": false,
    "vlm_chain_dump_path": "logs/vlm_validation_chain.jsonl",
    "circuit_breaker": {
        "time_window_seconds": 300,
        "failure_rate_threshold": 0.5,
        "cooldown_seconds": 600
    },
    "pipeline_debug": false
}
